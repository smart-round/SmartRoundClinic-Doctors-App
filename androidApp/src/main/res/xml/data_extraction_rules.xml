<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. See the note there. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure-shared-preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure-shared-preferences.xml" />
    </device-transfer>
</data-extraction-rules>
